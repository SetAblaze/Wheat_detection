# Пример переменных окружения. Скопируйте файл в .env и раскомментируйте
# нужные строки. Сам .env в git не попадает (см. .gitignore).
# Формат: WHEAT_<РАЗДЕЛ>__<ПАРАМЕТР>, разделы как в configs/config.yaml.

# Считать на процессоре, даже если есть видеокарта
# WHEAT_PREDICT__DEVICE=cpu
# WHEAT_TRAIN__DEVICE=cpu

# Другой файл весов
# WHEAT_PATHS__WEIGHTS=models/best.pt

# Порог уверенности модели
# WHEAT_PREDICT__CONF=0.25

# Размер пакета при обучении (меньше, если не хватает памяти видеокарты)
# WHEAT_TRAIN__BATCH=8
